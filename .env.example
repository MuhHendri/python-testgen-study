# Copy to .env and fill in. Never commit .env.
# Proprietary backbone (OpenAI-compatible endpoint)
PROPRIETARY_BASE_URL=
PROPRIETARY_API_KEY=
# Open-weight backbone (OpenAI-compatible endpoint, local or hosted)
OPENWEIGHT_BASE_URL=
OPENWEIGHT_API_KEY=
# Local LLM logging proxy (llm_proxy/); tools are pointed at this address
PROXY_PORT=8088
